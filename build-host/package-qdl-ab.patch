+def patch_rawprogram_ab(path):
+    """efi shrinks to 128MB, boot_a/boot_b get their slot's U-Boot copy, linux_a/linux_b get boot.img,
+    rootfs is called super."""
+    tree = ET.parse(path)
+    root = tree.getroot()
+    programs = {e.get("label"): e for e in root.iter("program")}
+    efi = programs["efi"]
+    efi.set("num_partition_sectors", str(EFI_SECTORS))
+    efi.set("size_in_KB", f"{EFI_SECTORS / 2:.1f}")
+    for slot in ("_a", "_b"):
+        programs["boot" + slot].set("filename", f"boot-uboot{slot}.img")
+    if "rootfs" in programs:
+        programs["rootfs"].set("label", "super")
+    for label in ("linux_a", "linux_b"):
+        if label in programs:
+            root.remove(programs[label])
+    for label, start in (("linux_a", LINUX_A_START_SECTOR), ("linux_b", LINUX_B_START_SECTOR)):
+        e = ET.SubElement(root, "program")
+        for k, v in efi.attrib.items():
+            e.set(k, v)
+        e.set("label", label)
+        e.set("filename", "../linux.img")
+        e.set("start_sector", str(start))
+        e.set("num_partition_sectors", str(LINUX_SECTORS))
+        e.set("size_in_KB", f"{LINUX_SECTORS / 2:.1f}")
+        e.set("start_byte_hex", hex(start * 512))
+    tree.write(path)
+
