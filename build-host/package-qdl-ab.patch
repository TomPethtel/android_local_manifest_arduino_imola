+# U-Boot script in efi. ABL boots U-Boot from boot_a or boot_b by the GPT slot bits; each copy's boot image
+# header command line carries uboot.slot=_a or _b (make_uboot_slot_image), which ABL hands on in
+# /chosen/bootargs. Read the slot from there, load that slot's Android boot image from linux_a or linux_b
+# (sized from its header), and bootm it; U-Boot prepends bootargs to the image's own command line. This
+# U-Boot ignores the header's load addresses and runs the kernel where it sits in the image, and an arm64
+# kernel must start on a 2 MB boundary (unaligned, it panics at once), so the image goes one page below one.
+# On failure, reset so ABL counts the attempt.
+BOOT_CMD = """# LineageOS A/B boot for Arduino Uno Q (Imola), written by device/arduino/imola/tools/package_qdl.py
+setenv slot _a
+fdt addr ${fdtcontroladdr}
+fdt get value ablargs /chosen bootargs
+setexpr ablslot sub ".*uboot.slot=(_[ab]).*" "\\\\1" "${ablargs}"
+if test "${ablslot}" = "_b"; then setenv slot _b; fi
+echo "Android slot ${slot}"
+if part start mmc 0 linux${slot} lstart; then
+  mmc dev 0
+  mmc read ${loadaddr} ${lstart} 8
+  setexpr a ${loadaddr} + 24; setexpr.l pg *${a}
+  setexpr pm ${pg} - 1
+  setexpr total ${pg}
+  for f in 8 10 18 660 670; do setexpr a ${loadaddr} + ${f}; setexpr.l n *${a}; setexpr n ${n} + ${pm}; setexpr n ${n} / ${pg}; setexpr n ${n} * ${pg}; setexpr total ${total} + ${n}; done
+  setexpr blocks ${total} + 1ff; setexpr blocks ${blocks} / 200
+  setexpr img 10a600000 - ${pg}
+  mmc read ${img} ${lstart} ${blocks}
+  setenv bootargs "androidboot.slot_suffix=${slot} @EXTRA@"
+  bootm ${img}
+fi
+echo "Could not boot slot ${slot}"
+reset
+"""
 
+
+def make_uboot_slot_image(src, dst, slot):
+    """Copies the U-Boot boot image, adding uboot.slot=<slot> to its header command line (not hashed)."""
+    data = bytearray(open(src, "rb").read())
+    if data[:8] != b"ANDROID!":
+        raise ValueError(f"{src} is not an Android boot image")
+    cmdline = data[64:64 + 512].rstrip(b"\0").decode()
+    cmdline = " ".join([w for w in cmdline.split() if not w.startswith("uboot.slot=")] + [f"uboot.slot={slot}"])
+    if len(cmdline) >= 512:
+        raise ValueError("U-Boot boot image command line too long")
+    data[64:64 + 512] = cmdline.encode().ljust(512, b"\0")
+    open(dst, "wb").write(data)
+
